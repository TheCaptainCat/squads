{% set delivered = data.delivered %}
{% set outstanding = data.outstanding %}
{% set settled_not_delivered = data.settled %}
{% macro member_line(r) %}- **{{ r.id }}** ({{ r.type }}) {{ r.status }} — {{ r.title }}{% if r.assignee %} — {{ r.assignee }}{% endif %}
{% endmacro %}
## Delivered ({{ delivered | length }})

{% if delivered %}
{% for r in delivered %}
{{ member_line(r) }}
{% endfor %}

{% else %}
_(none yet)_

{% endif %}
## Outstanding ({{ outstanding | length }})

{% if outstanding %}
{% for r in outstanding %}
{{ member_line(r) }}
{% endfor %}

{% else %}
_(nothing outstanding)_

{% endif %}
## Settled without delivering ({{ settled_not_delivered | length }})

{% if settled_not_delivered %}
{% for r in settled_not_delivered %}
{{ member_line(r) }}
{% endfor %}
{% else %}
_(none)_
{% endif %}
