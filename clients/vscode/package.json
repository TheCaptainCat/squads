{
  "name": "squads-vscode",
  "displayName": "Squads",
  "description": "Browse your AI-agent team's work items, roster, and workflow in VS Code — read-only companion for squads-managed projects.",
  "version": "0.14.0",
  "publisher": "pierre-chat",
  "author": "Pierre Chat",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheCaptainCat/squads"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Visualization"
  ],
  "keywords": [
    "ai agents",
    "multi-agent systems",
    "agent orchestration",
    "claude code",
    "agentic development",
    "work item tracking",
    "issue tracking",
    "project tracking",
    "team roster",
    "markdown"
  ],
  "qna": false,
  "icon": "resources/squads-icon-marketplace.png",
  "main": "./out/src/extension.js",
  "activationEvents": [],
  "contributes": {
    "configuration": {
      "title": "Squads",
      "properties": {
        "squads.sqPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the sq binary. Takes priority over every other discovery strategy."
        },
        "squads.command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Full command + argv prefix used to invoke sq (e.g. [\"uv\", \"run\", \"sq\"]). Ignored when squads.sqPath is set."
        },
        "squads.typeIcons": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Codicon id per item type name (e.g. { \"task\": \"checklist\" }), layered over the bundled defaults: epic -> milestone, feature -> rocket, task -> checklist, bug -> bug, decision -> lightbulb, review -> eye, guide -> book. Types with no match here or in the bundled defaults fall back to a generic icon. Does not affect the fixed role/skill/operator roster icons."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "squads",
          "title": "Squads",
          "icon": "resources/squads-icon-vscode.svg"
        }
      ]
    },
    "views": {
      "squads": [
        {
          "id": "squadsTree",
          "name": "Work Items",
          "icon": "resources/squads-icon-vscode.svg"
        },
        {
          "id": "squadsMeta",
          "name": "Roster",
          "icon": "resources/squads-icon-vscode.svg"
        },
        {
          "id": "squadsRecords",
          "name": "Records",
          "icon": "resources/squads-icon-vscode.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "squads.refreshAll",
        "title": "Refresh All",
        "category": "Squads",
        "icon": "$(refresh)"
      },
      {
        "command": "squads.filterByType",
        "title": "Filter by Type...",
        "category": "Squads"
      },
      {
        "command": "squads.toggleGroupByType",
        "title": "Group by Type",
        "category": "Squads",
        "icon": "$(list-flat)"
      },
      {
        "command": "squads.ungroupByType",
        "title": "Ungroup",
        "category": "Squads",
        "icon": "$(list-tree)"
      },
      {
        "command": "squads.toggleShowClosed",
        "title": "Show Closed Items",
        "category": "Squads",
        "icon": "$(eye-closed)"
      },
      {
        "command": "squads.hideClosed",
        "title": "Hide Closed Items",
        "category": "Squads",
        "icon": "$(eye)"
      },
      {
        "command": "squads.clearFiltersAndGrouping",
        "title": "Clear Filters and Grouping",
        "category": "Squads"
      },
      {
        "command": "squads.toggleShowArchived",
        "title": "Show Archived Entries",
        "category": "Squads",
        "icon": "$(eye-closed)"
      },
      {
        "command": "squads.hideArchived",
        "title": "Hide Archived Entries",
        "category": "Squads",
        "icon": "$(eye)"
      },
      {
        "command": "squads.toggleGroupByTypeMeta",
        "title": "Group by Type",
        "category": "Squads",
        "icon": "$(list-flat)"
      },
      {
        "command": "squads.ungroupByTypeMeta",
        "title": "Ungroup",
        "category": "Squads",
        "icon": "$(list-tree)"
      },
      {
        "command": "squads.filterMetaByStatus",
        "title": "Filter by Status...",
        "category": "Squads"
      },
      {
        "command": "squads.clearMetaFilter",
        "title": "Clear Filter",
        "category": "Squads"
      },
      {
        "command": "squads.toggleGroupByTypeRecords",
        "title": "Group by Type",
        "category": "Squads",
        "icon": "$(list-flat)"
      },
      {
        "command": "squads.ungroupByTypeRecords",
        "title": "Ungroup",
        "category": "Squads",
        "icon": "$(list-tree)"
      },
      {
        "command": "squads.toggleShowTerminal",
        "title": "Show Terminal Records",
        "category": "Squads",
        "icon": "$(eye-closed)"
      },
      {
        "command": "squads.hideTerminal",
        "title": "Hide Terminal Records",
        "category": "Squads",
        "icon": "$(eye)"
      },
      {
        "command": "squads.clearRecordsFilter",
        "title": "Clear Filter",
        "category": "Squads"
      },
      {
        "command": "squads.openWorkflow",
        "title": "Open Workflow Cheatsheet",
        "category": "Squads",
        "icon": "$(book)"
      },
      {
        "command": "squads.previewBack",
        "title": "Back",
        "category": "Squads",
        "icon": "$(arrow-left)"
      },
      {
        "command": "squads.previewForward",
        "title": "Forward",
        "category": "Squads",
        "icon": "$(arrow-right)"
      },
      {
        "command": "squads.search",
        "title": "Search...",
        "category": "Squads"
      }
    ],
    "keybindings": [
      {
        "command": "squads.previewBack",
        "key": "alt+left",
        "when": "activeWebviewPanelId == squadsItemPreview"
      },
      {
        "command": "squads.previewForward",
        "key": "alt+right",
        "when": "activeWebviewPanelId == squadsItemPreview"
      },
      {
        "command": "squads.search",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "squads.refreshAll",
          "when": "view == squadsTree",
          "group": "navigation@1"
        },
        {
          "command": "squads.toggleGroupByType",
          "when": "view == squadsTree && !squads.groupByType",
          "group": "navigation@2"
        },
        {
          "command": "squads.ungroupByType",
          "when": "view == squadsTree && squads.groupByType",
          "group": "navigation@2"
        },
        {
          "command": "squads.toggleShowClosed",
          "when": "view == squadsTree && !squads.showClosed",
          "group": "navigation@3"
        },
        {
          "command": "squads.hideClosed",
          "when": "view == squadsTree && squads.showClosed",
          "group": "navigation@3"
        },
        {
          "command": "squads.openWorkflow",
          "when": "view == squadsTree",
          "group": "navigation@4"
        },
        {
          "command": "squads.filterByType",
          "when": "view == squadsTree",
          "group": "1_squads"
        },
        {
          "command": "squads.clearFiltersAndGrouping",
          "when": "view == squadsTree",
          "group": "1_squads"
        },
        {
          "command": "squads.refreshAll",
          "when": "view == squadsMeta",
          "group": "navigation@1"
        },
        {
          "command": "squads.toggleGroupByTypeMeta",
          "when": "view == squadsMeta && !squads.metaGroupByType",
          "group": "navigation@2"
        },
        {
          "command": "squads.ungroupByTypeMeta",
          "when": "view == squadsMeta && squads.metaGroupByType",
          "group": "navigation@2"
        },
        {
          "command": "squads.toggleShowArchived",
          "when": "view == squadsMeta && !squads.metaShowArchived",
          "group": "navigation@3"
        },
        {
          "command": "squads.hideArchived",
          "when": "view == squadsMeta && squads.metaShowArchived",
          "group": "navigation@3"
        },
        {
          "command": "squads.filterMetaByStatus",
          "when": "view == squadsMeta",
          "group": "1_squads"
        },
        {
          "command": "squads.clearMetaFilter",
          "when": "view == squadsMeta",
          "group": "1_squads"
        },
        {
          "command": "squads.refreshAll",
          "when": "view == squadsRecords",
          "group": "navigation@1"
        },
        {
          "command": "squads.toggleGroupByTypeRecords",
          "when": "view == squadsRecords && !squads.recordsGroupByType",
          "group": "navigation@2"
        },
        {
          "command": "squads.ungroupByTypeRecords",
          "when": "view == squadsRecords && squads.recordsGroupByType",
          "group": "navigation@2"
        },
        {
          "command": "squads.toggleShowTerminal",
          "when": "view == squadsRecords && !squads.recordsShowTerminal",
          "group": "navigation@3"
        },
        {
          "command": "squads.hideTerminal",
          "when": "view == squadsRecords && squads.recordsShowTerminal",
          "group": "navigation@3"
        },
        {
          "command": "squads.clearRecordsFilter",
          "when": "view == squadsRecords",
          "group": "1_squads"
        }
      ]
    }
  },
  "scripts": {
    "vendor:mermaid": "node scripts/copy-mermaid.js",
    "compile": "npm run vendor:mermaid && tsc -p ./",
    "watch": "tsc -w -p ./",
    "typecheck": "tsc --noEmit -p ./",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:canary": "vitest run --config vitest.canary.config.ts",
    "test:e2e": "npm run compile && node ./out/test/extensionHost/runTest.js",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "mermaid": "^11.16.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
